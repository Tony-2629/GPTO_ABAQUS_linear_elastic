    vertices=mdb.models['Model-1'].rootAssembly.instances['Beam-1'].vertices.getSequenceFromMask(
    mask=('[#1 ]', ), )))
mdb.models['Model-1'].EncastreBC(createStepName='Static_Load', localCsys=None, 
